# VM disk images and ISOs (generated, large)
*.qcow2
*.img
*.iso

# UEFI firmware (copied from `brew --prefix qemu`)
*.fd

# Cloud-init seed source (regenerated by vm.sh from the config block)
seed/

# SSH keypairs for VM access (per-machine secrets)
vm_key
vm_key.pub

# Console password for the VM user (per-machine secret)
vm_password

# macOS
.DS_Store

# Editor / IDE
*.swp
.idea/
.vscode/
